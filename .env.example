# 8Token Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3001
JWT_SECRET=your-super-secret-jwt-key-change-me

# Admin
ADMIN_SECRET=your-admin-secret-change-me

# Kirvano Integration
# Webhook token (set this in Kirvano's webhook configuration)
KIRVANO_WEBHOOK_TOKEN=your-webhook-token-here

# Checkout URLs for each plan (get these from your Kirvano product pages)
KIRVANO_CHECKOUT_MENSAL=https://pay.kirvano.com/your-checkout-id-mensal
KIRVANO_CHECKOUT_TRIMESTRAL=https://pay.kirvano.com/your-checkout-id-trimestral
KIRVANO_CHECKOUT_ANUAL=https://pay.kirvano.com/your-checkout-id-anual

# Product IDs from Kirvano (used to map webhook events to plans)
# Find these in your Kirvano product settings
KIRVANO_PRODUCT_MENSAL_ID=your-product-id-mensal
KIRVANO_PRODUCT_TRIMESTRAL_ID=your-product-id-trimestral
KIRVANO_PRODUCT_ANUAL_ID=your-product-id-anual

# Database (optional - defaults to local SQLite file)
# DATABASE_PATH=./data/8token.db

# CORS (optional - defaults to allow all origins in development)
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com